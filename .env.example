# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=transport_coord
DB_USER=transport_coord_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Notifications SMS (Twilio) — laissez NOTIFICATIONS_SIMULATION_MODE=True tant que
# vous n'avez pas de compte Twilio réel : aucun SMS n'est alors envoyé, tout est
# seulement journalisé et trace dans NotificationLog.
NOTIFICATIONS_SIMULATION_MODE=True
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
