# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=transport_coord
DB_USER=transport_coord_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Notifications SMS (Twilio) — laissez NOTIFICATIONS_SIMULATION_MODE=True tant que
# vous n'avez pas de compte Twilio réel : aucun SMS n'est alors envoyé, tout est
# seulement journalisé et trace dans NotificationLog.
NOTIFICATIONS_SIMULATION_MODE=True

# Choix du fournisseur : auto (numéros +225 via Orange s'il est configuré, le reste
# via Twilio), orange ou twilio (force un fournisseur pour tous les numéros).
NOTIFICATIONS_SMS_PROVIDER=auto

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Orange SMS API (Côte d'Ivoire) — identifiants créés sur developer.orange.com.
# ORANGE_SMS_SENDER : numéro expéditeur au format international (ex. +2250000).
# ORANGE_SMS_SENDER_NAME : nom d'expéditeur affiché (optionnel).
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=
ORANGE_SMS_SENDER_NAME=
