# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
# 10.0.2.2 = la machine hôte vue depuis l'émulateur Android (application mobile).
# Pour un vrai téléphone, ajoutez l'adresse IP de votre PC sur le réseau local.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL
DB_NAME=transport_coord
DB_USER=transport_coord_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Billetterie : places réservées pour la vente hors ligne (application mobile).
# QUOTA=0 désactive la réservation (aucune vente hors ligne garantie).
BILLETTERIE_QUOTA_HORS_LIGNE=2
BILLETTERIE_RESERVATION_TTL_HEURES=12
BILLETTERIE_HORIZON_HORS_LIGNE_HEURES=24

# Notifications SMS (Twilio) — laissez NOTIFICATIONS_SIMULATION_MODE=True tant que
# vous n'avez pas de compte Twilio réel : aucun SMS n'est alors envoyé, tout est
# seulement journalisé et trace dans NotificationLog.
NOTIFICATIONS_SIMULATION_MODE=True

# Choix du fournisseur : auto (numéros +225 via Orange s'il est configuré, le reste
# via Twilio), orange ou twilio (force un fournisseur pour tous les numéros).
NOTIFICATIONS_SMS_PROVIDER=auto

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp via Twilio. TWILIO_WHATSAPP_FROM : numéro expéditeur au format international
# (sans "whatsapp:"), ex. bac à sable Twilio +14155238886 (le client doit d'abord le
# rejoindre). TWILIO_WHATSAPP_CONTENT_SID : modèle approuvé, obligatoire en production
# pour écrire à un client qui ne nous a pas contacté ; ses variables sont
# {{1}}=nom, {{2}}=ligne, {{3}}=date et heure, {{4}}=prix.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Canaux utilisés pour confirmer une vente de ticket : sms, whatsapp ou sms,whatsapp.
NOTIFICATIONS_CANAUX_TICKET=sms,whatsapp

# Orange SMS API (Côte d'Ivoire) — identifiants créés sur developer.orange.com.
# ORANGE_SMS_SENDER : numéro expéditeur au format international (ex. +2250000).
# ORANGE_SMS_SENDER_NAME : nom d'expéditeur affiché (optionnel).
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=
ORANGE_SMS_SENDER_NAME=
